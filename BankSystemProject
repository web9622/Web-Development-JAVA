import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

class Account{
	private String id;
	private String name;
	private double balance;
	
	public Account(String id,String name,double initialBalance) {
		this.id=id;
		this.name=name;
		this.balance=initialBalance;
	}
	//getter,setter

	public String getId() {
		return id;
	}

	public void setId(String id) {
		this.id = id;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public double getBalance() {
		return balance;
	}

	public void setBalance(double balance) {
		this.balance = balance;
	}
	

}

public class BankSystem {
	private List<Account> accounts;
	private boolean isLoggedIn;
	private String  currentUser;
	public BankSystem() {
		super();
		this.accounts = new ArrayList<>();
		this.isLoggedIn = false;
		this.currentUser = null;
		}
	//3. 계좌생성
	public void createAccount(String name, double initialBalance) {
		String accountId=generateAccountId();
		Account account=new Account(accountId,name,initialBalance);
		accounts.add(account);
		System.out.println("계좌생성완료 계좌번호:"+accountId);
		}
	//4. 계좌 목록보기
	public void displayAllAccounts() {
		if(accounts.isEmpty()) {
			System.out.println("등록된 계좌 없음");
		}else {
			for(Account account:accounts) {
				System.out.println("계좌번호:"+account.getId()+",이름:"+account.getName());
			}
		}
	}
	//5. 계좌상세 정보
	public void displayAccountDetails(String accountId) {
		Account foundAccount=findAccountById(accountId);
		if(foundAccount!=null) {
			System.out.println("계좌번호"+foundAccount.getId());
			System.out.println("이름"+foundAccount.getName());
			System.out.println("잔고"+foundAccount.getBalance());
		}else {
			System.out.println("없는 계좌");
		}
	}
    //6. 입금
	public void deposit(String accountId,double amount) {
		Account account =findAccountById(accountId);
		if(account!=null) {
			account.setBalance(account.getBalance()+amount);
			System.out.println("입금 후 잔액"+account.getBalance()+"원");
		}else {
			System.out.println("해당 계좌 없음");
		}
	}
	
	//7. 출금
		public void withdraw(String accountId,double amount) {
			Account account=findAccountById(accountId);
			if(account!=null && account.getBalance()>=amount ) {
				
			}else if(account==null) {
				System.out.println("해당 계좌없음");
			}else {System.out.println("잔액부족");}
		}
			
	//8. 이체
	public void transfer(String fromAccountId, String toAccountId, double amount) {
	Account fromAccount=findAccountById(fromAccountId);	
	Account toAccount=findAccountById(toAccountId);	
	if(fromAccount!=null&&toAccount!=null&&fromAccount.getBalance()>=amount) {
		fromAccount.setBalance(fromAccount.getBalance()-amount);
		toAccount.setBalance(fromAccount.getBalance()+amount);
		System.out.println("이체완료. 송금 후 잔액:"+fromAccount.getBalance());
		System.out.println("송금 받은 계좌 잔액:"+toAccount.getBalance());
		}else if(fromAccount==null||toAccount==null) {
			System.out.println("송금자 or 송금 받는자 계좌정보 확인");
		} else {
			System.out.println("출금계좌 잔액 부족");
		}
	}
	
	//9. 계좌 삭제
		public void deleteAccount(String accountId) {
			Account account=findAccountById(accountId);
			if(account!=null) {
				accounts.remove(account);
				System.out.println("계좌삭제 완료");	
			}else {
				System.out.println("해당계좌없음 ");
			}
		}
	
	
	
	//관리자와 사용자 로그인
