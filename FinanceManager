        displayCategories();

        System.out.print("지출 카테고리 입력: ");
        String category = scanner.nextLine();
        boolean exists = false;
        for (Category c : categories) {
            if (c.getCategoryName().equalsIgnoreCase(category)) {
                exists = true;
                break;
            }
        }
        if (!exists) {
            addCategory(category);  // 자동 추가
        }
        addExpense(accountId, amount, category, LocalDate.now());
    }
