import java.io.*;
import java.time.LocalDate;
import java.util.*;

class User implements Serializable {
    private String name;
    private String accountId;
    private double balance;

    public User(String name, String accountId, double balance) {
        this.name = name;
        this.accountId = accountId;
        this.balance = balance;
    }

    public String getName() { return name; }
    public String getAccountId() { return accountId; }
    public double getBalance() { return balance; }
    public void setBalance(double balance) { this.balance = balance; }
}

class Income implements Serializable{
    private double amount;
    private String category;
    private LocalDate eventDate;

    public Income(double amount, String category, LocalDate eventDate) {
        this.amount = amount;
        this.category = category;
        this.eventDate = eventDate;
    }

    public double getAmount() { return amount; }
    public String getCategory() { return category; }
    public LocalDate getEventDate() { return eventDate; }
}

class Expense implements Serializable {
    private double amount;
    private String category;
    private LocalDate eventDate;

    public Expense(double amount, String category, LocalDate eventDate) {
        this.amount = amount;
        this.category = category;
        this.eventDate = eventDate;
    }

    public double getAmount() { return amount; }
    public String getCategory() { return category; }
    public LocalDate getEventDate() { return eventDate; }
}

class Budget implements Serializable {
    private double limit;

    public Budget(double limit) {
        this.limit = limit;
    }

    public double getLimit() { return limit; }
}

class Category implements Serializable {
    private String categoryName;

    public Category(String categoryName) {
        this.categoryName = categoryName;
    }

    public String getCategoryName() { return categoryName; }
}

public class FinanceManager {
    private List<User> users;
    private List<Category> categories;
    private List<Budget> budgets;
    private List<Income> incomes;
    private List<Expense> expenses;
    private boolean isLoggedIn;
    private String currentUser;
    private static int nextAccountId = 1;


    public FinanceManager() {
        this.users = new ArrayList<>();
        this.categories = new ArrayList<>();
        this.budgets = new ArrayList<>();
        this.incomes = new ArrayList<>();
        this.expenses = new ArrayList<>();
        this.isLoggedIn = false;
        this.currentUser = null;
    }

    private String generateAccountId() {
        return String.valueOf(nextAccountId++);
    }

    //1.로그인
    public boolean login(String username, String password) {
        for (User u : users) {
            if (u.getName().equals(username) && password.equals("12345")) {
                isLoggedIn = true;
                currentUser = username;
                return true;
            }
        }
        return false;
    }
//2.회원가입
    public void registerUser(String name, double initialBalance) {
        String accountId = generateAccountId();
        User user = new User(name, accountId, initialBalance);
        users.add(user);
        System.out.println("회원가입 완료. 계좌번호: " + accountId);
    }

    private User findUserByAccountId(String accountId) {
        for (User user : users) {
            if (user.getAccountId().equals(accountId)) return user;
        }
        return null;
    }
//3.사용자관리
private void manageUser(Scanner scanner) {
