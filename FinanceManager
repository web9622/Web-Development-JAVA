    public void deleteUser(String accountId) {
        User user = findUserByAccountId(accountId);
        if (user != null) {
            users.remove(user);
            System.out.println("사용자 삭제 완료");
        } else {
            System.out.println("해당 사용자 없음");
        }
    }
//4.수입관리
    public void addIncome(String accountId, double amount, String category, LocalDate eventDate) {
        User user = findUserByAccountId(accountId);
        if (user != null) {
            user.setBalance(user.getBalance() + amount);
            Income income = new Income(amount, category, eventDate);
            incomes.add(income);
            //incomes.add(new Income(amount, category, eventDate));
            System.out.println("수입 추가 완료: 날짜=" + eventDate + ", 금액=" + amount + ", 카테고리=" + category);
            checkBudgetLimit(category, amount);
        }
    }
    //5.지출관리
    public void addExpense(String accountId, double amount, String category, LocalDate eventDate) {
        User user = findUserByAccountId(accountId);
        if (user != null) {
            if (user.getBalance() < amount) {
                System.out.println("잔액 부족: 지출이 실패했습니다.");
                return;
            }

            user.setBalance(user.getBalance() - amount);
            Expense expense = new Expense(amount, category, eventDate);
            expenses.add(expense);
            System.out.println("지출 추가 완료: 날짜=" + eventDate + ", 금액=" + amount + ", 카테고리=" + category);
            checkBudgetLimit(category, amount);
        } else {
            System.out.println("계좌를 찾을 수 없습니다.");
        }
    }
    //6.예산관리 -초과알림
    private void checkBudgetLimit(String category, double newExpense) {
        if (budgets.isEmpty()) return;

        double totalExpenses = expenses.stream().mapToDouble(Expense::getAmount).sum();
        double budgetLimit = budgets.get(0).getLimit();

        if (totalExpenses > budgetLimit) {
            System.out.printf("예산 초과 경고: 전체 예산 한도(%,.2f원) 초과됨! 현재 총 지출: %, .2f원\n", budgetLimit, totalExpenses);
        }
    }

    //6.예산관리 - 예산설정,예산조회
    private void manageBudget(Scanner scanner) {
        System.out.println("1. 예산 설정");
        System.out.println("2. 예산 조회");
        System.out.print("선택: ");
        int choice = scanner.nextInt();
        scanner.nextLine();

        if (choice == 1) {
            System.out.print("예산 한도: ");
            double limit = scanner.nextDouble();
            scanner.nextLine();

            if(!budgets.isEmpty()){
                budgets.clear();
            }
            budgets.add(new Budget(limit));
            System.out.println("예산이 설정되었습니다.");
        } else if (choice == 2) {
            if (budgets.isEmpty()) {
                System.out.println("설정된 예산이 없습니다.");
            } else {
                System.out.println("전체 예산 한도:"+budgets.get(0).getLimit()+"원");
            }
        } else {
            System.out.println("잘못된 선택입니다.");
        }
    }
//7.카테고리추가
    public void addCategory(String categoryName) {
        for (Category c : categories) {
            if (c.getCategoryName().equalsIgnoreCase(categoryName)) {
                System.out.println("이미 존재하는 카테고리입니다.");
                return;
            }
        }
        categories.add(new Category(categoryName));
        System.out.println("카테고리 추가 완료: " + categoryName);
    }
//7.카테고리삭제
    public void deleteCategory(String categoryName) {
        Iterator<Category> iterator = categories.iterator();
        while (iterator.hasNext()) {
            Category c = iterator.next();
            if (c.getCategoryName().equalsIgnoreCase(categoryName)) {
                iterator.remove();
                System.out.println("카테고리 삭제 완료: " + categoryName);
                return;
            }
        }
        System.out.println("존재하지 않는 카테고리입니다.");
    }
//7.카테고리목록
    public void displayCategories() {
