    //8.검색
    public void search(Scanner scanner) {
        System.out.println("검색 조건을 선택하세요:");
        System.out.println("1. 날짜로 검색");
        System.out.println("2. 카테고리로 검색");
        System.out.println("3. 금액 범위로 검색");
        System.out.print("선택: ");
        int choice = scanner.nextInt();
        scanner.nextLine();

        switch (choice) {
            case 1:
                searchByDate(scanner);
                break;
            case 2:
                searchByCategory(scanner);
                break;
            case 3:
                searchByAmountRange(scanner);
                break;
            default:
                System.out.println("잘못된 선택입니다.");
                break;
        }

    }
    private void searchByDate(Scanner scanner) {
        System.out.print("검색할 날짜 (yyyy-MM-dd): ");
        String input = scanner.nextLine();
        LocalDate date;
        try {
            date = LocalDate.parse(input);
        } catch (Exception e) {
            System.out.println("잘못된 날짜 형식입니다.");
            return;
        }

        System.out.println("수입 내역:");
        for (Income i : incomes) {
            if (i.getEventDate().equals(date)) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", i.getEventDate(), i.getAmount(), i.getCategory());
            }
        }

        System.out.println("지출 내역:");
        for (Expense e : expenses) {
            if (e.getEventDate().equals(date)) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", e.getEventDate(), e.getAmount(), e.getCategory());
            }
        }
    }
    private void searchByCategory(Scanner scanner) {
        System.out.print("검색할 카테고리: ");
        String category = scanner.nextLine();

        System.out.println("수입 내역:");
        for (Income i : incomes) {
            if (i.getCategory().equalsIgnoreCase(category)) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", i.getEventDate(), i.getAmount(), i.getCategory());
            }
        }

        System.out.println("지출 내역:");
        for (Expense e : expenses) {
            if (e.getCategory().equalsIgnoreCase(category)) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", e.getEventDate(), e.getAmount(), e.getCategory());
            }
        }
    }
    private void searchByAmountRange(Scanner scanner) {
        System.out.print("최소 금액: ");
        double min = scanner.nextDouble();
        System.out.print("최대 금액: ");
        double max = scanner.nextDouble();
        scanner.nextLine();

        System.out.println("수입 내역:");
        for (Income i : incomes) {
            if (i.getAmount() >= min && i.getAmount() <= max) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", i.getEventDate(), i.getAmount(), i.getCategory());
            }
        }

        System.out.println("지출 내역:");
        for (Expense e : expenses) {
            if (e.getAmount() >= min && e.getAmount() <= max) {
                System.out.printf("- [%s] %, .2f원 (%s)\n", e.getEventDate(), e.getAmount(), e.getCategory());
            }
        }
    }
//9.통계
    private void showStatistics() {
        System.out.println("\n[통계 기능]");
        calculateTotalIncomeAndExpense();
        showMonthlyStatistics();
        showCategoryExpenseStatistics();
    }

    // 총 수입 / 지출 계산
    private void calculateTotalIncomeAndExpense() {
        double totalIncome = incomes.stream().mapToDouble(Income::getAmount).sum();
        double totalExpense = expenses.stream().mapToDouble(Expense::getAmount).sum();

        System.out.printf("총 수입: %, .2f원\n", totalIncome);
        System.out.printf("총 지출: %, .2f원\n", totalExpense);
    }

    // 월별 수입/지출 통계
    private void showMonthlyStatistics() {
        Map<String, Double> incomeByMonth = new TreeMap<>();
        Map<String, Double> expenseByMonth = new TreeMap<>();

        for (Income i : incomes) {
            String key = i.getEventDate().getYear() + "-" + String.format("%02d", i.getEventDate().getMonthValue());
            incomeByMonth.put(key, incomeByMonth.getOrDefault(key, 0.0) + i.getAmount());
        }

        for (Expense e : expenses) {
            String key = e.getEventDate().getYear() + "-" + String.format("%02d", e.getEventDate().getMonthValue());
            expenseByMonth.put(key, expenseByMonth.getOrDefault(key, 0.0) + e.getAmount());
        }

        System.out.println("\n[월별 수입/지출]");
        Set<String> months = new TreeSet<>();
        months.addAll(incomeByMonth.keySet());
        months.addAll(expenseByMonth.keySet());

        for (String month : months) {
            double income = incomeByMonth.getOrDefault(month, 0.0);
            double expense = expenseByMonth.getOrDefault(month, 0.0);
            System.out.printf("%s → 수입: %, .2f원, 지출: %, .2f원\n", month, income, expense);
        }
    }

    // 카테고리별 지출 통계
    private void showCategoryExpenseStatistics() {
        Map<String, Double> expenseByCategory = new TreeMap<>();

        for (Expense e : expenses) {
            String category = e.getCategory();
            expenseByCategory.put(category, expenseByCategory.getOrDefault(category, 0.0) + e.getAmount());
        }

        System.out.println("\n[카테고리별 지출]");
        for (Map.Entry<String, Double> entry : expenseByCategory.entrySet()) {
            System.out.printf("%s: %, .2f원\n", entry.getKey(), entry.getValue());
        }
    }

    //10.파일저장
    // 저장할 파일 이름
    private static final String SAVE_FILE = "finance_data.dat";

    // 데이터 저장
    private void saveDataToFile() {
        try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(SAVE_FILE))) {
            oos.writeObject(users);
            oos.writeObject(categories);
            oos.writeObject(budgets);
            oos.writeObject(incomes);
            oos.writeObject(expenses);
            System.out.println("데이터가 저장되었습니다.");
        } catch (IOException e) {
            System.out.println("데이터 저장 중 오류 발생: " + e.getMessage());
        }
    }

    // 데이터 불러오기
    @SuppressWarnings("unchecked")
    private void loadDataFromFile() {
        File file = new File(SAVE_FILE);
        if (!file.exists()) return;

        try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(file))) {
            users = (List<User>) ois.readObject();
            categories = (List<Category>) ois.readObject();
            budgets = (List<Budget>) ois.readObject();
            incomes = (List<Income>) ois.readObject();
            expenses = (List<Expense>) ois.readObject();
            System.out.println("저장된 데이터를 불러왔습니다.");
        } catch (IOException | ClassNotFoundException e) {
            System.out.println("데이터 불러오기 중 오류 발생: " + e.getMessage());
        }
    }

