}
    private void listUsers() {
        if (users.isEmpty()) {
            System.out.println("등록된 사용자가 없습니다.");
        } else {
            System.out.println("사용자 목록:");
            for (User user : users) {
                System.out.printf("- 이름: %s, 계좌번호: %s, 잔액: %,.2f원\n",
                        user.getName(), user.getAccountId(), user.getBalance());
            }
